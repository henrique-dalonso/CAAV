# Ambiente Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Segredos
.env
app/ferramentas/extratus/config/config.json
app/ferramentas/extratus_aburesi/config/config.json
app/ferramentas/emenda/config/config.json

# Prompt de instruções: definido e sobrescrito pela tela de Configurações
# (upload/edição ao vivo pelo admin), não pelo código - nunca deve ser
# versionado. Achado real (2026-09-09): o arquivo ativo tinha ficado
# tracked por engano, uma edição ao vivo de uma semana quase se perdeu no
# primeiro deploy que tocou nesse caminho. Histórico de versões
# (historico_prompts/) já era ignorado antes, agora o próprio arquivo
# ativo também é.
app/ferramentas/nucleo_relatorios/config/instrucoes_relatorio.txt
app/ferramentas/nucleo_relatorios/config/historico_prompts/
app/ferramentas/extratus_aburesi/config/instrucoes_relatorio.txt
app/ferramentas/extratus_aburesi/config/historico_prompts/
# EMENDA (2026-09-09): mesmo motivo acima, mesmo padrão — prompt mora numa
# subpasta própria por tipo (config/prompts/, ver nucleo_relatorios/
# tipos.py), então o histórico de versões também fica dentro dela.
app/ferramentas/nucleo_relatorios/config/prompts/emenda.txt
app/ferramentas/nucleo_relatorios/config/prompts/historico_prompts/
# CONDENAÇÃO (2026-09-10): mesmo motivo/padrão acima.
app/ferramentas/nucleo_relatorios/config/prompts/condenacao.txt

# Dados reais de clientes / processos - nunca versionar
app/ferramentas/extratus/dados/entrada_pdfs/*
!app/ferramentas/extratus/dados/entrada_pdfs/.gitkeep
app/ferramentas/extratus/dados/processados/*
!app/ferramentas/extratus/dados/processados/.gitkeep
app/ferramentas/extratus/dados/erros/*
!app/ferramentas/extratus/dados/erros/.gitkeep
app/ferramentas/extratus/dados/revisao/*
!app/ferramentas/extratus/dados/revisao/.gitkeep
app/ferramentas/extratus/dados/relatorios_prontos/*
!app/ferramentas/extratus/dados/relatorios_prontos/.gitkeep
app/ferramentas/extratus/dados/robo_entrada_pdfs/*
!app/ferramentas/extratus/dados/robo_entrada_pdfs/.gitkeep

# Mesma regra acima, espelhada pro módulo Extratus - Aburesi (pastas
# completamente separadas, mesmo cuidado com dado real de cliente)
app/ferramentas/extratus_aburesi/dados/entrada_pdfs/*
!app/ferramentas/extratus_aburesi/dados/entrada_pdfs/.gitkeep
app/ferramentas/extratus_aburesi/dados/processados/*
!app/ferramentas/extratus_aburesi/dados/processados/.gitkeep
app/ferramentas/extratus_aburesi/dados/erros/*
!app/ferramentas/extratus_aburesi/dados/erros/.gitkeep
app/ferramentas/extratus_aburesi/dados/revisao/*
!app/ferramentas/extratus_aburesi/dados/revisao/.gitkeep
app/ferramentas/extratus_aburesi/dados/relatorios_prontos/*
!app/ferramentas/extratus_aburesi/dados/relatorios_prontos/.gitkeep
app/ferramentas/extratus_aburesi/dados/robo_entrada_pdfs/*
!app/ferramentas/extratus_aburesi/dados/robo_entrada_pdfs/.gitkeep

# Mesma regra acima, espelhada pro módulo EMENDA (2026-09-09)
app/ferramentas/emenda/dados/entrada_pdfs/*
!app/ferramentas/emenda/dados/entrada_pdfs/.gitkeep
app/ferramentas/emenda/dados/processados/*
!app/ferramentas/emenda/dados/processados/.gitkeep
app/ferramentas/emenda/dados/erros/*
!app/ferramentas/emenda/dados/erros/.gitkeep
app/ferramentas/emenda/dados/revisao/*
!app/ferramentas/emenda/dados/revisao/.gitkeep
app/ferramentas/emenda/dados/relatorios_prontos/*
!app/ferramentas/emenda/dados/relatorios_prontos/.gitkeep
app/ferramentas/emenda/dados/robo_entrada_pdfs/*
!app/ferramentas/emenda/dados/robo_entrada_pdfs/.gitkeep

# Logs (contêm dado real de processamento)
app/ferramentas/extratus/logs/*
!app/ferramentas/extratus/logs/.gitkeep
app/ferramentas/extratus_aburesi/logs/*
!app/ferramentas/extratus_aburesi/logs/.gitkeep
app/ferramentas/emenda/logs/*
!app/ferramentas/emenda/logs/.gitkeep
app/ferramentas/nucleo_relatorios/logs/*
!app/ferramentas/nucleo_relatorios/logs/.gitkeep
app/plataforma/logs/*
!app/plataforma/logs/.gitkeep

# Banco local (histórico + usuários — dado real)
banco/*
!banco/.gitkeep
*.db
*.sqlite3

# Arquivo de controle do watchdog do servidor (número do processo atual,
# recriado a cada vez que o servidor sobe - não é algo pra versionar)
servidor.pid

# Arquivo de trava temporário que o Excel/Word criam sozinhos enquanto um
# .xlsx/.docx está aberto — nunca é conteúdo de verdade, nunca versionar.
~$*.xlsx
~$*.docx

# Exportação real do NPJUR (Crivus) — mesma regra de "dado real de
# cliente/processo nunca versionado" das pastas dados/ do Extratus acima.
app/ferramentas/crivus/config/*.xlsx

# Prompt mestre + manual complementar do Crivus (Henrique, 2026-09-09:
# "PROMPTS NÃO DEVEM SER VERSIONADOS NO GIT, ELES DEVEM SER
# IRRASTREÁVEIS PARA NÃO FICAR ALTERANDO SEMPRE") — decisão invertida da
# anterior (esses .docx eram versionados normalmente até aqui). Trocar o
# conteúdo agora é só sobrescrever o arquivo em config/ + reiniciar o
# servidor, nunca mais via commit/git pull.
app/ferramentas/crivus/config/Prompt PUBLICAÇÕES.docx
app/ferramentas/crivus/config/COMPLEMENTAR - MANUAL.docx

# Anexos reais enviados no Leitor de Publicação (sentenças, petições —
# documento de cliente) — mesma regra acima.
app/ferramentas/crivus/dados/anexos/*
!app/ferramentas/crivus/dados/anexos/.gitkeep
