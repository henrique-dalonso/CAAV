# Copie este arquivo para ".env" (sem ".example") e preencha os valores.
# O ".env" real nunca deve ser commitado — já está no .gitignore.

# Chave usada pra assinar o cookie de sessão de login. Gere um valor
# aleatório qualquer e mantenha fixo (se mudar, todo mundo é deslogado).
EXTRATUS_SECRET_KEY=

# Chave de acesso à IA (Anthropic/Claude). Obrigatória — a integração
# real de IA está sempre ligada, todo PDF processado (manual ou Motor)
# chama essa API. Sem essa chave, o processamento falha.
ANTHROPIC_API_KEY=
